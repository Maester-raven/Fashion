{
  "environment_name": "fashion312-release",
  "environment_prefix_policy": "user_or_conda_managed",
  "repository_files": {
    "environment_definition": "environments/environment_3_1_2_release.yml",
    "requirements_lock": "environments/requirements_3_1_2_lock.txt"
  },
  "python": "3.10.20",
  "cuda_runtime": "12.1",
  "torch": "2.1.2+cu121",
  "torchvision": "0.16.2+cu121",
  "mmcv": "2.1.0 compiled cu121/torch2.1 wheel",
  "mmengine": "0.10.7",
  "mmdet": "3.3.0",
  "tensorrt": "10.13.3.9 (tensorrt-cu12 public wheel)",
  "onnx": "1.16.2",
  "onnxruntime": {
    "required": false,
    "reason": "not imported by frozen 3.1.1 TensorRT or 3.1.2 functional runtime"
  },
  "numpy": "1.26.4",
  "opencv_python": "4.11.0.86",
  "pycocotools": "2.0.11",
  "transformers": "4.32.0",
  "timm": "1.0.27",
  "install_order": [
    "conda base packages",
    "Torch/Torchvision CUDA 12.1 wheels",
    "MMCV compiled wheel",
    "MMEngine/MMDetection",
    "TensorRT CUDA 12 wheel and libraries",
    "remaining runtime packages"
  ],
  "fresh_environment_created": true,
  "fresh_environment_from_scratch": true,
  "no_conda_clone": true,
  "no_site_packages_copy": true,
  "no_external_pythonpath": true,
  "three_one_three_dependencies_added": false
}
